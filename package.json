{
  "name": "api-balance",
  "version": "0.1.0",
  "description": "Real-time DeepSeek API account balance readout for the DeepSeek Harness web GUI (dsh web).",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "plugin",
    "balance"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
